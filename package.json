    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ignore": "^7.0.16",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  },
  "devDependencies": {
    "vitest": "^5.1.1"
  }
}
