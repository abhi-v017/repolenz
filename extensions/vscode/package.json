{
  "name": "repolenz",
  "displayName": "RepoLenz - Codebase Intelligence & Dependency Graph",
  "description": "Interactive codebase dependency graphs, change impact analysis, and AST code intelligence inside VS Code.",
  "version": "0.1.1",
  "publisher": "repolenz",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhi-v017/repolenz.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "repolenz",
    "dependency-graph",
    "codebase-intelligence",
    "ast",
    "tree-sitter",
    "architecture",
    "impact-analysis"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "npx @vscode/vsce package"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repolenz-sidebar",
          "title": "RepoLenz",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "repolenz-sidebar": [
        {
          "id": "repolenz.sidebar",
          "name": "RepoLenz Intelligence"
        }
      ]
    },
    "commands": [
      {
        "command": "repolenz.open",
        "title": "RepoLenz: Open Visual Dependency Map",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "repolenz.analyzeActiveFile",
        "title": "RepoLenz: Analyze Change Impact",
        "icon": "$(pulse)"
      },
      {
        "command": "repolenz.searchSymbols",
        "title": "RepoLenz: Search Workspace Symbols",
        "icon": "$(symbol-method)"
      },
      {
        "command": "repolenz.askQA",
        "title": "RepoLenz: Ask Codebase Question",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "repolenz.reindex",
        "title": "RepoLenz: Re-Index Workspace",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "repolenz.open",
          "group": "navigation",
          "when": "!isOutput"
        }
      ],
      "editor/context": [
        {
          "command": "repolenz.analyzeActiveFile",
          "group": "7_modification",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "repolenz.analyzeActiveFile",
          "group": "7_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "repolenz.open"
        },
        {
          "command": "repolenz.analyzeActiveFile"
        },
        {
          "command": "repolenz.searchSymbols"
        },
        {
          "command": "repolenz.askQA"
        },
        {
          "command": "repolenz.reindex"
        }
      ]
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ignore": "^7.0.16",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  }
}